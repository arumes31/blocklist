{
  "openapi": "3.0.1",
  "info": {
    "title": "Blocklist API",
    "description": "API for managing and monitoring blocked IP addresses with GeoIP enrichment and real-time updates.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Data Retrieval",
      "description": "Fetching blocked IPs and whitelist data"
    },
    {
      "name": "Enforcement",
      "description": "Blocking, unblocking, and whitelisting actions"
    },
    {
      "name": "Monitoring",
      "description": "Statistics and health information"
    },
    {
      "name": "Management",
      "description": "Settings, API tokens, and administration"
    }
  ],
  "paths": {
    "/api/v1/ips": {
      "get": {
        "tags": [
          "Data Retrieval"
        ],
        "summary": "List blocked IPs with advanced filtering",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Number of records to return",
            "schema": {
              "type": "integer",
              "default": 500
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor (timestamp score)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "description": "Text search across IP, reason, etc.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Filter by ISO country code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "added_by",
            "in": "query",
            "description": "Filter by who added the block",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Filter by start date (ISO8601)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Filter by end date (ISO8601)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of blocked IPs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/IPListItem"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "next": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/ips/{ip}/details": {
      "get": {
        "tags": [
          "Data Retrieval"
        ],
        "summary": "Get detailed information for a specific IP",
        "parameters": [
          {
            "name": "ip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed IP information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IPEntry"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/ips_list": {
      "get": {
        "tags": [
          "Data Retrieval"
        ],
        "summary": "Get simple JSON array of all blocked IPs",
        "responses": {
          "200": {
            "description": "Simple list of IPs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/raw": {
      "get": {
        "tags": [
          "Data Retrieval"
        ],
        "summary": "Get plain-text list of blocked IPs",
        "responses": {
          "200": {
            "description": "Newline-separated list of IPs",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/whitelists": {
      "get": {
        "tags": [
          "Data Retrieval"
        ],
        "summary": "Get JSON list of all whitelisted IPs/ranges",
        "responses": {
          "200": {
            "description": "List of whitelisted entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/whitelists-raw": {
      "get": {
        "tags": [
          "Data Retrieval"
        ],
        "summary": "Get plain-text list of whitelisted IPs",
        "responses": {
          "200": {
            "description": "Newline-separated list of whitelisted IPs",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/stats": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Get aggregate blocking statistics",
        "responses": {
          "200": {
            "description": "Statistics object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/webhook": {
      "post": {
        "tags": [
          "Enforcement"
        ],
        "summary": "Perform Enforcement Action (Ban/Unban/Whitelist)",
        "description": "Unified endpoint for all automated actions. Requires a Bearer Token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "act": {
                    "type": "string",
                    "description": "Action to perform",
                    "enum": [
                      "ban",
                      "unban",
                      "whitelist",
                      "selfwhitelist",
                      "ban-ip",
                      "unban-ip"
                    ]
                  },
                  "ip": {
                    "type": "string",
                    "description": "IPv4 or IPv6 address. Required for most actions.",
                    "example": "1.2.3.4"
                  },
                  "reason": {
                    "type": "string",
                    "description": "Reason for the action",
                    "example": "Brute force attack"
                  },
                  "persist": {
                    "type": "boolean",
                    "description": "If true, IP is stored in the database indefinitely",
                    "default": false
                  },
                  "ttl": {
                    "type": "integer",
                    "description": "Time-to-live in seconds (ephemeral blocks only).",
                    "example": 86400
                  }
                },
                "required": [
                  "act"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action successfully performed"
          },
          "400": {
            "description": "Invalid IP format or missing parameters"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Insufficient permissions"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/excluded": {
      "get": {
        "tags": [
          "Management"
        ],
        "summary": "Get list of excluded IPs/subnets",
        "responses": {
          "200": {
            "description": "List of excluded entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/views": {
      "get": {
        "tags": [
          "Management"
        ],
        "summary": "Get saved dashboard views",
        "responses": {
          "200": {
            "description": "List of saved views",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Management"
        ],
        "summary": "Create a new saved view",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "config": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "View created"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "IPEntry": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "isp": {
            "type": "string"
          },
          "geo": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            }
          },
          "reason": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "IPListItem": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/IPEntry"
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "active_blocks": {
            "type": "integer",
            "description": "Currently active blocks in system"
          },
          "total": {
            "type": "integer",
            "description": "Persistent total bans ever recorded"
          },
          "hour": {
            "type": "integer"
          },
          "day": {
            "type": "integer"
          },
          "top_countries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "country": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
